# OpenAI API Key for AI features
VITE_OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Async Workload API Key
VITE_ASYNC_WORKLOAD_API_KEY=your-async-workload-api-key

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Stripe Price IDs - Configure these in your Stripe dashboard
# Free tier (no price ID needed)
# Starter Plan
VITE_STRIPE_STARTER_MONTHLY_PRICE_ID=price_starter_monthly_id
VITE_STRIPE_STARTER_ANNUAL_PRICE_ID=price_starter_annual_id
# Professional Plan
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_id
VITE_STRIPE_PRO_ANNUAL_PRICE_ID=price_pro_annual_id
# Team Plan
VITE_STRIPE_TEAM_MONTHLY_PRICE_ID=price_team_monthly_id
VITE_STRIPE_TEAM_ANNUAL_PRICE_ID=price_team_annual_id

# Application URL (for redirects)
VITE_APP_URL=http://localhost:3002