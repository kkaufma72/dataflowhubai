VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_ASYNC_WORKLOAD_API_KEY=your-async-workload-api-key

# Backend API URL (default: http://localhost:8000)
VITE_BACKEND_URL=http://localhost:8000

# API Base URL for production deployment
# In dev: leave empty (proxied by Vite)
# In production: set to your FastAPI backend URL (e.g., https://api.yourdomain.com)
VITE_API_BASE_URL=

# Flower monitoring dashboard URL (optional - only needed in production)
# In dev mode, defaults to http://localhost:5555 if not set
# Example production: VITE_FLOWER_URL=https://flower.yourdomain.com
VITE_FLOWER_URL=

OPENAI_API_KEY=your_openai_api_key_here

# Stripe Configuration (for payments/subscriptions)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# FRED API Key (for economic data)
VITE_FRED_API_KEY=your_fred_api_key_here

# Error Tracking (Sentry)
VITE_SENTRY_DSN=https://your_sentry_dsn_here

# Analytics (PostHog)
VITE_POSTHOG_API_KEY=phc_your_posthog_api_key_here
VITE_POSTHOG_HOST=https://app.posthog.com