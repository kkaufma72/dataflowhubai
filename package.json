{
  "name": "dataflow-hub-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:report": "cypress run && npm run merge-reports && npm run generate-report",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "stripe:setup": "node scripts/setup-stripe-products.mjs",
    "analyze": "vite-bundle-visualizer",
    "build:analyze": "vite build && vite-bundle-visualizer",
    "perf:setup": "./setup-performance-tools.sh",
    "merge-reports": "mochawesome-merge cypress/reports/*.json > cypress/reports/report.json || echo 'No reports to merge'",
    "generate-report": "marge cypress/reports/report.json -f report -o cypress/reports || echo 'No report to generate'"
  },
  "overrides": {
    "parse5": "^7.1.2"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.53",
    "@ai-sdk/react": "^2.0.80",
    "@influxdata/influxdb-client": "^1.35.0",
    "@langchain/community": "^1.0.0",
    "@langchain/core": "^1.0.1",
    "@langchain/langgraph": "^1.0.1",
    "@langchain/openai": "^1.0.0",
    "@stripe/stripe-js": "^8.1.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.76.1",
    "@tensorflow/tfjs": "^4.15.0",
    "@tensorflow/tfjs-vis": "^1.1.0",
    "@tremor/react": "^3.14.1",
    "ai": "^5.0.80",
    "chart.js": "^4.4.1",
    "d3": "^7.8.5",
    "file-saver": "^2.0.5",
    "idb": "^8.0.0",
    "jszip": "^3.10.1",
    "langchain": "^1.0.1",
    "log4js": "^6.9.1",
    "lucide-react": "^0.344.0",
    "mathjs": "^15.0.0",
    "neo4j-driver": "^6.0.0",
    "neovis.js": "^2.1.0",
    "openai": "^6.5.0",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.12",
    "react-hot-toast": "^2.4.1",
    "react-joyride": "^2.7.2",
    "react-loading-skeleton": "^3.4.0",
    "react-router-dom": "^6.30.1",
    "react-window": "^1.8.10",
    "simple-statistics": "^7.8.8",
    "stripe": "^19.1.0",
    "swagger-ui-react": "^5.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "autoprefixer": "^10.4.22",
    "cypress": "^15.5.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "identity-obj-proxy": "^3.0.0",
    "jest-axe": "^8.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "jsdom": "^27.0.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.0",
    "mochawesome-report-generator": "^6.3.2",
    "msw": "^2.2.3",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^6.0.5",
    "supabase": "^2.53.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.2.2",
    "typescript-eslint": "^7.18.0",
    "vite": "^7.2.4",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.0.14"
  }
}
